          "name": "Upload Certificate",
          "request": {
            "name": "Upload Certificate",
            "description": {
              "content": "Upload a CA certificate to trust in browser sessions. Certificates are managed at the team level.\nOnce uploaded, reference the certificate by name when creating sessions to trust services using that CA.\n\nSee [CA Certificates documentation](/advanced/ca-certificates) for more details.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "certificates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "anchor-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Unique identifier for the certificate (alphanumeric, hyphens, underscores only, 1-255 characters)"
                },
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) Certificate file (.crt, .pem, .cer, or .der format)"
                },
                {
                  "key": "description",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional description of the certificate (max 1000 characters)"
                }
              ]
            }
          },
