                  "value": "anchor-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"<string>\",\n  \"format\": \"<string>\",\n  \"wait\": \"<integer>\",\n  \"new_page\": \"<boolean>\",\n  \"page_index\": \"<integer>\",\n  \"return_partial_on_timeout\": \"<boolean>\"\n}",
