          "name": "Get Webpage Content",
          "request": {
            "name": "Get Webpage Content",
            "description": {
              "content": "Retrieve the rendered content of a webpage in Markdown or HTML format. Text content is also extracted from PDFs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "tools",
                "fetch-webpage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sessionId",
                  "value": "<string>",
                  "description": "An optional browser session identifier to reference an existing running browser session. If provided, the tool will execute within that browser session."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
