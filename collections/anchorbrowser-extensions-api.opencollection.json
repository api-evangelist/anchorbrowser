{
  "opencollection": "1.0.0",
  "info": {
    "name": "AnchorBrowser Agentic capabilities Extensions API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Extensions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Extensions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.anchorbrowser.io/v1/extensions",
            "auth": {
              "type": "apikey",
              "key": "anchor-api-key",
              "value": "{{anchor-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Get all extensions for the authenticated user"
        },
        {
          "info": {
            "name": "Upload Extension",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.anchorbrowser.io/v1/extensions",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "key": "anchor-api-key",
              "value": "{{anchor-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Upload a new browser extension as a ZIP file. The extension will be validated and stored for use in browser sessions."
        },
        {
          "info": {
            "name": "Get Extension Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.anchorbrowser.io/v1/extensions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the extension to retrieve"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "anchor-api-key",
              "value": "{{anchor-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Get details of a specific extension by its ID"
        },
        {
          "info": {
            "name": "Delete Extension",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.anchorbrowser.io/v1/extensions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the extension to delete"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "anchor-api-key",
              "value": "{{anchor-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Delete an extension and remove it from storage"
        }
      ]
    }
  ],
  "bundled": true
}