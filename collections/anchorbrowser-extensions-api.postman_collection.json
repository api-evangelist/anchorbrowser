          "name": "Upload Extension",
          "request": {
            "name": "Upload Extension",
            "description": {
              "content": "Upload a new browser extension as a ZIP file. The extension will be validated and stored for use in browser sessions.",
              "type": "text/plain"
            },
            "url": {
