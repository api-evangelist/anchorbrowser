{
  "opencollection": "1.0.0",
  "info": {
    "name": "AnchorBrowser Agentic capabilities Billing API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Billing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Billing Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.anchorbrowser.io/v1/billing",
            "auth": {
              "type": "apikey",
              "key": "anchor-api-key",
              "value": "{{anchor-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves credit balance, current-period credit usage, tier, and billing limits for the authenticated project."
        }
      ]
    }
  ],
  "bundled": true
}