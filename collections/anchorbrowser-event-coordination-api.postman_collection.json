          "name": "Wait for Event",
          "request": {
            "name": "Wait for Event",
            "description": {
              "content": "Waits for a specific event to be signaled by another process, workflow, or session. \nThis endpoint blocks until the event is signaled or the timeout is reached.\nUseful for coordinating between multiple browser sessions or workflows.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "events",
                ":event_name",
                "wait"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "event_name",
                  "description": "(Required) The name of the event to wait for"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
